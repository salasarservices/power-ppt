# PowerPPT API settings (env prefix POWERPPT_). Copy to .env for local dev.
# In production these come from Google Secret Manager, not a file.

# POWERPPT_TEMPLATE_PATH=            # defaults to templates/2026/Salasar_Corporate_Blank.pptx
POWERPPT_TEMPLATE_VERSION=2026
POWERPPT_CORS_ORIGINS=["http://localhost:5173"]

POWERPPT_OCR_ENABLED_DEFAULT=true
POWERPPT_OCR_BACKEND=auto

# Secrets — leave blank locally unless testing cloud OCR
POWERPPT_GOOGLE_SERVICE_ACCOUNT_JSON=
POWERPPT_AWS_ACCESS_KEY_ID=
POWERPPT_AWS_SECRET_ACCESS_KEY=
POWERPPT_AWS_DEFAULT_REGION=us-east-1
