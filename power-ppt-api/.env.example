# PowerPPT API settings (prefix POWERPPT_). Copy to .env for local dev.
# In Cloud Run these are set as service env vars / Secret Manager references,
# NOT committed. Never commit a real .env.

# Brand template (bundled default is fine; override only to test another template).
# POWERPPT_TEMPLATE_PATH=/app/templates/2026/Salasar_Corporate_Blank.pptx
POWERPPT_TEMPLATE_VERSION=2026

# Single-service topology: path to the built SPA the API serves at /.
# Set inside the image; leave unset locally to run the API alone.
# POWERPPT_WEB_DIST_PATH=/app/web_static

# CORS — only needed when the web is served from a different origin (dev).
# Single-service prod is same-origin, so this is unused there.
POWERPPT_CORS_ORIGINS=["http://localhost:5173"]

# OCR
POWERPPT_OCR_ENABLED_DEFAULT=true
POWERPPT_OCR_BACKEND=auto

# Document AI (A3 — image-of-a-table -> native table). Auth via the runtime
# service account (ADC), no key. Unset -> images always kept as-is. See DEPLOY.md.
# POWERPPT_DOCAI_PROJECT=power-ppt-486306
# POWERPPT_DOCAI_LOCATION=us
# POWERPPT_DOCAI_PROCESSOR_ID=

# Tier-2 AI extraction — Vertex AI Gemini (render + transcribe picture/freeform
# decks). COMPLIANCE: Vertex only, no-train. Unset -> native extraction only.
# Needs LibreOffice (in the image) + roles/aiplatform.user. See DEPLOY.md.
# POWERPPT_VERTEX_PROJECT=power-ppt-486306
# POWERPPT_VERTEX_LOCATION=us-central1
# POWERPPT_VERTEX_MODEL=gemini-2.5-flash
# POWERPPT_AI_EXTRACT_DEFAULT=false
# POWERPPT_SOFFICE_BIN=            # optional LibreOffice path override

# --- Secrets: prefer the Cloud Run service account (ADC) over key files. ---
# Google Vision: grant the runtime service account roles/serviceusage.serviceUsageConsumer
# + Vision access instead of pasting a key. Only set this if you must use a key.
# POWERPPT_GOOGLE_SERVICE_ACCOUNT_JSON=
# AWS Textract fallback (only if used):
# POWERPPT_AWS_ACCESS_KEY_ID=
# POWERPPT_AWS_SECRET_ACCESS_KEY=
# POWERPPT_AWS_DEFAULT_REGION=us-east-1
